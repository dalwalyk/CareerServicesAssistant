# Free Google Gemini key from https://aistudio.google.com/apikey
LLM_API_KEY=your-key-here

# Optional: defaults to Google Gemini's OpenAI-compatible endpoint and model.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash

# Groq instead (free key from https://console.groq.com/keys):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Local Ollama instead (the key can be any non-empty value; use any pulled
# model that supports tools):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3
